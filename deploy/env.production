# App settings appended to .env on the FIRST deploy; on later deploys only
# keys that are still missing are added, existing values are never changed.
# Secrets (APP_KEY, SESSION_SECRET) are generated separately by deploy.sh.

# ------------------------------------------------------------------- TLS ---
# The app terminates TLS itself: there is no root on this server, so no nginx
# and no binding to 443. HTTPS answers on 3443; the HTTP port (PORT) runs a
# redirect-only listener that sends everything to HTTPS.
SSL_ENABLED=true
HTTPS_PORT=3443
HTTP_REDIRECT=true
SSL_MIN_VERSION=TLSv1.2

# Fallback used to build the redirect URL when a request arrives with an
# unusable Host header. Left empty on purpose: a request with a valid Host
# still redirects normally, and a malformed one gets a 400 rather than a
# redirect to somewhere else. Set it to this server's hostname or IP if you
# want that fallback.
PUBLIC_HOST=

# COOKIE_SECURE is deliberately not set: it follows SSL_ENABLED, so cookies are
# marked Secure exactly when there is TLS to protect them.

# ---------------------------------------------------------------- policy ---
APP_NAME=APEX Instant Sharing
TRUST_PROXY=0
REQUIRE_MFA=true
ALLOW_SELF_REGISTRATION=true
ADMIN_CAN_DOWNLOAD_ALL=false
MAX_UPLOAD_MB=200
MAX_FILES_PER_UPLOAD=10
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
