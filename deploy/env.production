# App settings appended to .env on the FIRST deploy only (deploy.sh).
# Edit the server's .env directly afterwards - this file is not re-applied.

# The app is served over plain HTTP on the LAN, so the Secure cookie flag has
# to be off or sign-in cookies are never sent. Put it behind an HTTPS reverse
# proxy and switch this to true (and TRUST_PROXY=1).
COOKIE_SECURE=false
TRUST_PROXY=0

APP_NAME=APEX Instant Sharing
REQUIRE_MFA=true
ALLOW_SELF_REGISTRATION=true
ADMIN_CAN_DOWNLOAD_ALL=false
MAX_UPLOAD_MB=200
MAX_FILES_PER_UPLOAD=10
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
