# App settings appended to .env on the FIRST deploy; on later deploys only
# keys that are still missing are added, existing values are never changed.
# Secrets (APP_KEY, SESSION_SECRET) are generated separately by deploy.sh.

# ------------------------------------------------------------------- TLS ---
# The app terminates TLS itself: there is no root on this server, so no nginx
# and no binding to 443. HTTPS answers on 3443; the HTTP port (PORT) runs a
# redirect-only listener that sends everything to HTTPS.
SSL_ENABLED=true
HTTPS_PORT=3443
HTTP_REDIRECT=true
SSL_MIN_VERSION=TLSv1.2

# Fallback used to build the redirect URL when a request arrives with an
# unusable Host header, and the name the app calls itself in the links it
# hands out.
PUBLIC_HOST=instantsharing.supportlab.cloud

# The origin recipients see. Public share links are printed against this, so it
# must be the name people reach the app by - not the backend host and port.
PUBLIC_BASE_URL=https://instantsharing.supportlab.cloud

# COOKIE_SECURE is deliberately not set: it follows SSL_ENABLED, so cookies are
# marked Secure exactly when there is TLS to protect them.

# ---------------------------------------------------------------- policy ---
APP_NAME=APEX Instant Sharing

# Apache terminates the public TLS and proxies to this app over HTTPS, so there
# is exactly one hop in front. Trusting it is what puts the real visitor's IP in
# the audit trail instead of the proxy's own address.
TRUST_PROXY=1
REQUIRE_MFA=true
# Starting values only. Both are administrator-controlled in the app from here
# on, and the stored decision survives restarts and redeploys.
ALLOW_SELF_REGISTRATION=true
ALLOW_PUBLIC_LINKS=true
ADMIN_CAN_DOWNLOAD_ALL=false
MAX_UPLOAD_MB=200
MAX_FILES_PER_UPLOAD=10
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
