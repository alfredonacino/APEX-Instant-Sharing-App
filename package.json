{
  "name": "apex-instant-sharing-app",
  "version": "1.0.0",
  "description": "Secure internal file sharing app with registered users, per-user and all-user sharing, MFA (TOTP) and a tamper-evident audit trail.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init:admin": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  }
}
