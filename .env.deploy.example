# ---------------------------------------------------------------------------
# Deployment target for ./deploy.sh
#
#   cp .env.deploy.example .env.deploy    then fill in your own server
#
# .env.deploy is git-ignored: your server details never enter the repository.
# Every value can also be passed as an environment variable for a single run.
# ---------------------------------------------------------------------------

# Hostname or IP of the server to deploy to. Required - deploy.sh stops
# without it. SSH must already work non-interactively (key-based) for the
# user below, because the script runs with BatchMode=yes.
DEPLOY_HOST=

# SSH user on that server. Defaults to your local username.
DEPLOY_USER=

# Base directory on the server. The app is deployed to $DEPLOY_BASE/<app name>.
# Defaults to /home/$DEPLOY_USER.
DEPLOY_BASE=

# Node version installed under $DEPLOY_BASE/.local and pinned for pm2.
# The app needs >= 22.5.0 for the built-in node:sqlite module.
NODE_VERSION=24.20.0

# HTTP port, which serves only the redirect to HTTPS.
APP_PORT=3210

# HTTPS port the health check probes on the server, over loopback.
HEALTH_PORT=3443
