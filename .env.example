# ---------------------------------------------------------------------------
# APEX Instant Sharing App - configuration
# Copy to .env and adjust. Every value below is optional in development;
# SESSION_SECRET and APP_KEY are REQUIRED when NODE_ENV=production.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public base URL, used for the TOTP enrolment label only.
APP_NAME=APEX Instant Sharing

# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts TOTP secrets at rest and keys the audit-log hash chain. NEVER rotate
# casually: rotating invalidates every enrolled authenticator and the audit chain.
APP_KEY=

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Storage / database locations (relative paths resolve against the project root)
DATA_DIR=./data
STORAGE_DIR=./storage/blobs

# Policy
REQUIRE_MFA=true              # every account must enrol TOTP before it can use the app
ALLOW_SELF_REGISTRATION=true  # false => only admins can create accounts
ADMIN_CAN_DOWNLOAD_ALL=false  # true => admins may download any file (always audited)
MAX_UPLOAD_MB=200
MAX_FILES_PER_UPLOAD=10
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Set to the number of proxies in front of the app (0 = none)
TRUST_PROXY=0
# Force the Secure cookie flag (defaults to true when NODE_ENV=production)
COOKIE_SECURE=
